<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeedAi.Infrastructure\DeedAi.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Swagger\deedai-swagger-authorize.css" />
    <EmbeddedResource Include="Swagger\deedai-swagger-authorize.js" />
  </ItemGroup>

  <!-- Vite emptyOutDir wipes wwwroot; copy Authorize assets after build/publish
       so the custom index pin-last script and CSS link resolve. The
       enablement middleware also serves the embedded copies (source of truth). -->
  <Target Name="CopyDeedAiSwaggerAuthorizeAssets" AfterTargets="CopyFilesToOutputDirectory">
    <MakeDir Directories="$(OutputPath)wwwroot\swagger" />
    <Copy SourceFiles="Swagger\deedai-swagger-authorize.js;Swagger\deedai-swagger-authorize.css"
          DestinationFolder="$(OutputPath)wwwroot\swagger"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishDeedAiSwaggerAuthorizeAssets" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)wwwroot\swagger" />
    <Copy SourceFiles="Swagger\deedai-swagger-authorize.js;Swagger\deedai-swagger-authorize.css"
          DestinationFolder="$(PublishDir)wwwroot\swagger"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
