# Copy to .env or export as environment variables / App Settings.
# Placeholders only — never commit real secrets.

# Key Vault secret names == App Setting keys (Azure).
# Wire KV references to these exact names. The app does NOT read ConnectionStrings__Default.
AdminSeedPassword=PLACEHOLDER
JwtSigningKey=PLACEHOLDER_AT_LEAST_32_CHARACTERS_LONG____
DocumentIntelligenceKey=PLACEHOLDER
BISDocumentIntelligenceEndpoint=https://PLACEHOLDER.cognitiveservices.azure.com/
StorageConnection=DefaultEndpointsProtocol=https;AccountName=stbisdeedai;AccountKey=PLACEHOLDER;EndpointSuffix=core.windows.net
SqlConnection=Server=tcp:deedaihost01.database.windows.net,1433;Database=dbdeedai;User ID=PLACEHOLDER;Password=PLACEHOLDER;Encrypt=True;

# Local / optional aliases
Database__Provider=Sqlite
ConnectionStrings__Sqlite=Data Source=deedai.db
Storage__Mode=Local
Storage__Container=deeds
Storage__LocalRoot=data/blobs
Queue__Mode=InMemory
Queue__Name=ocr-jobs

# Document Intelligence — use BISDocumentIntelligenceEndpoint (explicit).
# Ignore leftover DocumentIntelligenceEndpoint. Resource may be Central US.
Jwt__Issuer=deedai
Jwt__Audience=deedai-spa
Jwt__ExpiresMinutes=480

# CORS — explicit origins only. Do not use AnyOrigin + Credentials.
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=https://appdeedai.azurewebsites.net

# OCR worker
Ocr__RunInProcess=true
Ocr__PoisonDequeueCount=5
Ocr__VisibilityTimeoutSeconds=120
