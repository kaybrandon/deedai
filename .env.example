# Copy to .env or export as environment variables / App Settings.
# Placeholders only — never commit real secrets.

# Key Vault secret names == App Setting keys (Azure).
# Wire KV references to these exact names. The app does NOT read ConnectionStrings__Default.
AdminSeedPassword=PLACEHOLDER
JwtSigningKey=PLACEHOLDER_AT_LEAST_32_CHARACTERS_LONG____
# Leftover — ignored. Phase 6 removed Document Intelligence field-fill.
# DocumentIntelligenceKey=
# BISDocumentIntelligenceEndpoint=
StorageConnection=DefaultEndpointsProtocol=https;AccountName=stbisdeedai;AccountKey=PLACEHOLDER;EndpointSuffix=core.windows.net
SqlConnection=Server=tcp:deedaihost01.database.windows.net,1433;Database=dbdeedai;User ID=PLACEHOLDER;Password=PLACEHOLDER;Encrypt=True;

# Phase 2 — App Setting / Key Vault names (placeholders only; never commit real secrets).
SendGridApiKey=PLACEHOLDER
SendGridFromEmail=noreply@bisconsultants.com
AppPublicUrl=https://appdeedai.azurewebsites.net
SoftwareBaseUrl=https://PLACEHOLDER.example.com/
SoftwareApiKey=PLACEHOLDER
Software__Mode=Mock

# Local / optional aliases
Database__Provider=Sqlite
ConnectionStrings__Sqlite=Data Source=deedai.db
Storage__Mode=Local
Storage__Container=deeds
Storage__LocalRoot=data/blobs
Queue__Mode=InMemory
Queue__Name=ocr-jobs

# Brandon lock: Azure OpenAI in the same subscription as appdeedai.
# Cheapest capable chat model (gpt-4o-mini class). KV names == App Setting keys.
# Fail closed when Endpoint / Key / Deployment are missing. Do not raise quotas.
# Escalate spend to Chief of Staff before any spend bump or pricier model.
AzureOpenAIEndpoint=https://PLACEHOLDER.openai.azure.com/
AzureOpenAIKey=PLACEHOLDER
AzureOpenAIDeployment=gpt-4o-mini
AzureOpenAIModel=gpt-4o-mini
# AzureOpenAI:Mode=Mock
# AzureOpenAI:AllowPricierModel=false

Jwt__Issuer=deedai
Jwt__Audience=deedai-spa
Jwt__ExpiresMinutes=480

# SendGrid — App Settings / Key Vault only. Accepts SendGridApiKey or SendGrid__ApiKey.
SendGridApiKey=
SendGridFromEmail=noreply@bisconsultants.com
SendGridFromName=Deed AI

# SMTP — App Settings / Key Vault only when Admin email mode is SMTP.
# Host / port / TLS / username / password are never stored in the database.
SmtpHost=
SmtpPort=587
SmtpTls=true
SmtpUsername=
SmtpPassword=
SmtpTimeoutSeconds=30

# Software (never CAMA) — App Settings / Key Vault only. Accepts SoftwareApiKey or Software__ApiKey.
SoftwareBaseUrl=
SoftwareApiKey=

# CORS — explicit origins only. Do not use AnyOrigin + Credentials.
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=https://appdeedai.azurewebsites.net

# Session idle timeout (minutes). Default 30. Admin Settings can override.
Session__IdleTimeoutMinutes=30

# Swagger UI seed (non-Production only). Default OFF. After first run the Admin
# Settings toggle in the database wins. Never ON by default in Production.
# The app does not write Swagger__Enabled.
Swagger__Enabled=false

# OCR worker
Ocr__RunInProcess=true
Ocr__PoisonDequeueCount=5
Ocr__VisibilityTimeoutSeconds=120
